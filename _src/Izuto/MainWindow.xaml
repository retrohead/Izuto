<Window x:Class="Izuto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="MainWindow" 
        Width="890" 
        Height="550" 
        MinWidth="890" 
        MinHeight="550" 
        WindowStartupLocation="CenterScreen" 
        SizeChanged="Window_SizeChanged" 
        StateChanged="Window_StateChanged" 
        Loaded="Window_Loaded" 
        Closing="Window_Closing" 
        UseLayoutRounding="True"
        Icon="pack://application:,,,/Izuto;component/Resources/izuto.ico"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        >
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Izuto;component/Resources/Themes/Theme_Templates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <DockPanel Background="{DynamicResource WindowBackgroundBrushMedium}">
            <Grid x:Name="gridMain">
                <ui:UI_MainWindow x:Name="mainWindow" />

                <!--#region status box-->
                <StackPanel x:Name="panelSmallProgress" Visibility="Visible" Grid.Column="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,0,0" Grid.Row="1" VerticalAlignment="Center" Width="354" Panel.ZIndex="9999" IsVisibleChanged="panelSmallProgress_IsVisibleChanged">
                    <Grid>
                        <Border BorderThickness="1" BorderBrush="{DynamicResource WindowBackgroundBrushMedium}" CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect Opacity="1" ShadowDepth="1" Color="{DynamicResource ColorShadowAlpha}" BlurRadius="5" />
                            </Border.Effect>
                        </Border>
                        <Grid>
                            <Border CornerRadius="3" Background="{DynamicResource WindowBackgroundBrushDark}">
                            </Border>
                            <StackPanel>
                                <Grid x:Name="progressGrid">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="140"/>
                                        <RowDefinition Height="70*" MinHeight="70"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="28"/>
                                        <RowDefinition Height="5"/>
                                    </Grid.RowDefinitions>
                                    <Image Source="pack://application:,,,/Resources/IzutoLogoMedium.png" Height="110" />
                                    <TextBlock x:Name="lblProgress" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource LabelTextBrush}" RenderTransformOrigin="0,0" Background="Transparent" TextAlignment="Center" VerticalAlignment="Center" Height="Auto" Width="Auto" FontSize="12" Margin="10,5,10,5" Grid.Row="1"/>
                                    <ProgressBar x:Name="queueProgress" Value="{Binding ProgressQueueValue}" Maximum="100" Minimum="0" HorizontalAlignment="Center" Width="254" Height="16" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Row="2" Foreground="{DynamicResource ProgressBarColor}" Background="{DynamicResource WindowBackgroundBrushDark}" BorderBrush="{DynamicResource ControlBorder}" />
                                    <ProgressBar x:Name="mainProgress" Value="{Binding ProgressValue}" Maximum="100" Minimum="0" HorizontalAlignment="Center" Width="254" Height="16" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Row="3" Foreground="{DynamicResource ProgressBarColor}" Background="{DynamicResource WindowBackgroundBrushDark}" BorderBrush="{DynamicResource ControlBorder}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </StackPanel>
                <!--#endregion-->

                <!--#region footer -->
                <StackPanel x:Name="footerGrid" Background="Transparent" VerticalAlignment="Bottom" Height="32" Margin="0,0,0,0">
                    <StackPanel Panel.ZIndex="1" Margin="0" Background="Transparent">
                        <Grid Grid.Row="3" Grid.ColumnSpan="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="100*" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                        <Grid Width="Auto" VerticalAlignment="Center" Margin="0,-18,0,0" Background="{DynamicResource WindowBackgroundBrushMedium}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="10,-2,0,0">
                                <Image x:Name="imgConnectedStatus" Source="{Binding StatusIcon}" Width="16" Height="16" Margin="0" VerticalAlignment="Center" />
                                <Label x:Name="lblConnectedStatus" Content="{Binding StatusText}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" FontSize="11" FontFamily="{DynamicResource IzutoFont}"/>
                            </StackPanel>
                            <Grid Margin="10,3,5,0" VerticalAlignment="Bottom" Grid.Column="1" HorizontalAlignment="Right">
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <StackPanel Grid.Row="1" Margin="0,0,0,0">
                                    <Label x:Name="lblCopy" Content="{Binding Copyright}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource HeaderTextBrush}" FontSize="11" FontFamily="{DynamicResource IzutoFont}"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </StackPanel>
                </StackPanel>
                <!--#endregion-->

                <!--#region  enabled grids-->
                <DockPanel x:Name="panelEnabled" Panel.ZIndex="1000" Background="Transparent" Opacity="0" Visibility="Hidden" />
                <DockPanel x:Name="panelPopUpEnabled" Panel.ZIndex="10000" Background="Transparent" Opacity="0" Visibility="Hidden"/>
                <!--#endregion-->
            </Grid>
        </DockPanel>
    </Grid>
</Window>
