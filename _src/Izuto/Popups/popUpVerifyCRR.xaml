<UserControl x:Class="Izuto.popUpVerifyCRR"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:local="clr-namespace:Izuto"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:Themes="clr-namespace:Xceed.Wpf.Toolkit.Themes;assembly=Xceed.Wpf.Toolkit"
             mc:Ignorable="d" Height="500" MinHeight="500" MinWidth="600" Width="600">
    <DockPanel>
        <Grid Width="Auto" Margin="10" DockPanel.Dock="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBox x:Name="txtResults" Padding="10" Margin="10,10,0,10" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Style="{DynamicResource TextBoxStyle1}" Foreground="{DynamicResource ControlTextInactive}" Background="{DynamicResource WindowBackgroundBrushMedium}" IsReadOnly="True" />

            <StackPanel x:Name="buttons" Grid.Row="1">
                <Button x:Name="btnAccept" Content="Close Window" Margin="0,0,-15,-17" HorizontalAlignment="Right" Style="{DynamicResource PopUpAcceptButtonStyle}" Click="btnAccept_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>