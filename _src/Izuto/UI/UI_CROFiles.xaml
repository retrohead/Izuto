<UserControl x:Class="Izuto.UI.UI_CROFiles"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Izuto"
             xmlns:ui="clr-namespace:Izuto.UI"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="CRO Directory:" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
        <TextBox x:Name="textCROPath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
            <i:Interaction.Behaviors>
                <local:TextBoxEnterKeyUpdateBehavior />
            </i:Interaction.Behaviors>
        </TextBox>
        <Button Content="..." Grid.Column="3" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnSelectCROPath" Margin="1,0,0,0" ToolTip="Select a path containing CRO files" Height="27" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnSelectCROPath_Click" />

        <TabControl x:Name="tabsMain" Grid.Row="1" Grid.ColumnSpan="4" Margin="0,10,0,0" Style="{DynamicResource TabControlStyle1}" FontFamily="{DynamicResource IzutoFont}" FontSize="12" VerticalAlignment="Stretch" Visibility="Collapsed">
        </TabControl>
    </Grid>
</UserControl>
