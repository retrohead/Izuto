<UserControl x:Class="Izuto.UI.UI_MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Izuto"
             xmlns:ui="clr-namespace:Izuto.UI"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid x:Name="gridMain" Background="{DynamicResource WindowBackgroundBrushDark}">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Menu Background="{DynamicResource WindowBackgroundBrushMedium}">
                    <MenuItem x:Name="upperFileMenu" Header="File" SubmenuOpened="upperMenu_SubmenuOpened" Style="{DynamicResource MenuItemNoIconStyle}" Foreground="{DynamicResource ControlTextInactive}" Height="32">
                        <MenuItem Header="Open Archive" Click="MenuItem_Open_Click" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem x:Name="menuRecent" Header="Recent Items" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem Header="Exit" Click="MenuItem_Close_Click" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                    </MenuItem>
                    <MenuItem Header="Options" Style="{DynamicResource MenuItemNoIconStyle}" Foreground="{DynamicResource ControlTextInactive}" Height="32">
                        <MenuItem x:Name="menuSettings" Click="MenutItem_Settings_Click" Header="Translation Settings" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem x:Name="menuTheme" Click="MenutItem_Theme_Click" Header="Theme Settings" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                    </MenuItem>
                </Menu>
            </Grid>
            <Grid Margin="10,10,10,32" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                    <RowDefinition Height="5" />
                </Grid.RowDefinitions>
                <TextBlock Text="Archive FA File:" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBox x:Name="textArchiveFaPath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
                <Button Content="..." Grid.Column="3" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnOpenArchive" Margin="1,0,0,0" ToolTip="Open Archive File" Height="27" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="MenuItem_Open_Click" />

                <ListView VerticalAlignment="Stretch" x:Name="listView1" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}">
                    <ListView.View>
                        
                        <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                            <GridViewColumn x:Name="listPKBFileIcons" Width="25">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <Image HorizontalAlignment="Right" Height="20" Source="{Binding icon}" VerticalAlignment="Center" Margin="0,0,0,0" Grid.Column="0" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="File" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                        </GridView>
                    </ListView.View>
                </ListView>

                <Button Content="Explore Selected PKB File" Grid.ColumnSpan="2" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnExplorePKB" Margin="1,-1,0,0" ToolTip="Open Archive File" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnExplorePKB_Click" />
                <Image Grid.Row="2" Grid.RowSpan="2" Grid.Column="4" Source="pack://application:,,,/Resources/IzutoLogoSmall.png" />
            </Grid>

        </Grid>
    </Grid>
</UserControl>
