<UserControl x:Class="Izuto.UI.UI_MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Izuto"
             xmlns:ui="clr-namespace:Izuto.UI"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800" Loaded="UserControl_Loaded">
    <Grid>
        <Grid x:Name="gridMain" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Menu Background="{DynamicResource WindowBackgroundBrushDark}">
                    <MenuItem x:Name="upperFileMenu" Header="File" SubmenuOpened="upperMenu_SubmenuOpened" Style="{DynamicResource MenuItemNoIconStyle}" Foreground="{DynamicResource ControlTextInactive}" Height="32">
                        <MenuItem Header="Open Archive" Click="MenuItem_Open_Click" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem x:Name="menuRecent" Header="Recent Items" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem Header="Exit" Click="MenuItem_Close_Click" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                    </MenuItem>
                    <MenuItem Header="Options" Style="{DynamicResource MenuItemNoIconStyle}" Foreground="{DynamicResource ControlTextInactive}" Height="32">
                        <MenuItem x:Name="menuSettings" Click="MenutItem_Settings_Click" Header="Translation Settings" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                        <MenuItem x:Name="menuTheme" Click="MenutItem_Theme_Click" Header="Theme Settings" Style="{DynamicResource MenuItemStyle}" local:ThemeHelper.IsThemed="False" />
                    </MenuItem>
                </Menu>
            </Grid>

            <TabControl x:Name="tabsMain" Grid.Row="2" Margin="0,10,0,20" Style="{DynamicResource TabControlStyle1}" FontFamily="{DynamicResource IzutoFont}" FontSize="12" VerticalAlignment="Stretch">
                <TabItem x:Name="tabArchiveFA" Header="Archive FA" Style="{DynamicResource TabItemStyle1}">
                    <Grid Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="-5">
                        <ui:UI_ArchiveFA x:Name="uiArchiveFA" Margin="10" Grid.Row="1"/>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabCRO" Header="CRO Files" Style="{DynamicResource TabItemStyle1}">
                    <Grid Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="-5">
                        <ui:UI_CROFiles x:Name="uiCRO" Margin="10" Grid.Row="1"/>
                    </Grid>
                </TabItem>
            </TabControl>
            
            <Image Grid.Row="0" Grid.Column="4" Source="pack://application:,,,/Resources/IzutoLogoSmall.png" VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,0,0,-20" />
        </Grid>
    </Grid>
</UserControl>
