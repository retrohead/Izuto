<Window x:Class="Izuto.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        Title="Izuto Options" Height="519" Width="800" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="5,10,5,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="*" />
                <RowDefinition Height="32" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Options File:" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBox x:Name="textOptionsFilePath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
                <Button Content="..." Grid.Column="2" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnBrowseOptionsFile" Margin="1,0,0,0" ToolTip="Open an Izuto options file" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnBrowseOptionsFile_Click" />

            </Grid>

            <TabControl x:Name="tabsMain" Grid.Row="1" Margin="0,10,0,10" Style="{DynamicResource TabControlStyle1}" FontFamily="{DynamicResource IzutoFont}" FontSize="12" VerticalAlignment="Stretch">
                <TabItem x:Name="tabFileReplacements" Header="File Replacements" Style="{DynamicResource TabItemStyle1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="listViewFileReplacements" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="0" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}" Grid.ColumnSpan="2">
                            <ListView.View>

                                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="File To Replace" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Replacement File" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <Button 
                                x:Name="btnAddFileReplacement" 
                                ToolTip="Add a file to replace" 
                                Click="btnAddFileReplacement_Click" 
                                Content="Add" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
                                x:Name="btnRemoveFileReplacement" 
                                ToolTip="Remove the selected file replacement" 
                                Click="btnRemoveFileReplacement_Click" 
                                Content="Remove Selected" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
                                x:Name="btnRemoveAllFileReplacements" 
                                ToolTip="Remove all file replacements" 
                                Click="btnRemoveAllFileReplacements_Click" 
                                Content="Remove All" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
                                x:Name="btnModifyFileReplacement" 
                                ToolTip="Modify the selected file replacement" 
                                Click="btnModifyFileReplacement_Click" 
                                Content="Modify Selected" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                        </StackPanel>
                    </Grid>

                </TabItem>
                <TabItem x:Name="tabTextTranslations" Header="Text Translation" Style="{DynamicResource TabItemStyle1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <ListView VerticalAlignment="Stretch" x:Name="listViewTextTranslation" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="0" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}">
                            <ListView.View>

                                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Syllable" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Japanese Representation" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Original Hex" DisplayMemberBinding="{Binding SubItems, ConverterParameter=2, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Replacement Hex" DisplayMemberBinding="{Binding SubItems, ConverterParameter=3, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Unicode Code Point" DisplayMemberBinding="{Binding SubItems, ConverterParameter=4, Converter={StaticResource ListConverter}}" Width="Auto" />
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <StackPanel Orientation="Horizontal" Grid.Row="1">
                            <Button 
            x:Name="btnAddTextTranslation" 
            ToolTip="Add a new syllable replacement" 
            Click="btnAddTextTranslation_Click" 
            Content="Add" 
            Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
            x:Name="btnRemoveTextTranslation" 
            ToolTip="Remove the selected text translation" 
            Click="btnRemoveTextTranslation_Click" 
            Content="Remove Selected" 
            Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
            x:Name="btnRemoveAllTextTranslations" 
            ToolTip="Remove all text translations" 
            Click="btnRemoveAllTextTranslations_Click" 
            Content="Remove All" 
            Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
            x:Name="btnModifyTextTranslation" 
            ToolTip="Modify the selected text translation" 
            Click="btnModifyTextTranslation_Click" 
            Content="Modify Selected" 
            Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                        </StackPanel>
                    </Grid>


                </TabItem>
            </TabControl>
            <StackPanel Orientation="Horizontal" Grid.Row="2">
                <Button x:Name="btnSave" ToolTip="Save configuration file" Click="btnSave_Click" Content="Save Configuration" Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />
                <Button x:Name="btnSaveAs" ToolTip="Save configuration as a new file" Click="btnSaveAs_Click" Content="Save Configuration As..." Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />
            </StackPanel>

        </Grid>
    </Grid>
</Window>
