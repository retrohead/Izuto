<Window x:Class="Izuto.PACStringReplacementOptionsWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        Title="Izuto PAC String Replacement Options" Height="470" Width="600" MinHeight="470" MinWidth="600" MaxHeight="470" MaxWidth="600" Loaded="Window_Loaded">

    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="150"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Image Source="pack://application:,,,/Resources/IzutoLogoMedium.png" />

            <TextBlock x:Name="textMessage" Text="Message" TextWrapping="Wrap" Grid.Row="1" Margin="40,0,40,0" TextAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />


            <RadioButton x:Name="radioDest" IsChecked="True" Grid.Row="2" Content="Loaded File Priority (Try to find matching strings based on loaded file and copy where possible)" Grid.Column="0" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center" Cursor="Hand" VerticalContentAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="5,3,0,0" Style="{DynamicResource RadioButtonStyle}" />

            <RadioButton x:Name="radioSource" Grid.Row="3" Content="Source Priority (Scans source file and moves matching strings into the loaded file where possible)" Grid.Column="0" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center" Cursor="Hand" VerticalContentAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="5,3,0,0" Style="{DynamicResource RadioButtonStyle}" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="75"/>
                    <ColumnDefinition Width="100*"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="checkTextTranslateSource" Unchecked="checkTextTranslateSource_Checked" Checked="checkTextTranslateSource_Checked" IsChecked="True" Content="Translate Source" Grid.ColumnSpan="2" FontSize="12" VerticalContentAlignment="Center" HorizontalAlignment="Left" Margin="20,0,0,0" VerticalAlignment="Center" Cursor="Hand" Style="{DynamicResource CheckBoxStyle1}" FontFamily="{DynamicResource VestasSans}" Padding="5,3,0,0" />

                <TextBox x:Name="textTranslateFile" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>

                <Button 
                     x:Name="btnBrowseOptionsFile" 
                     ToolTip="Caancel the import process" 
                     Click="btnBrowseOptionsFile_Click" 
                     Content="..." 
                     Grid.Column="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="1,0,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

            </Grid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="5" Margin="0,10,0,0">
                <Button 
                    x:Name="btnContinue" 
                    ToolTip="Continue with the import process" 
                    Click="btnContinue_Click" 
                    Content="Continue" 
                    Width="150" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                <Button 
                    x:Name="btnCancel" 
                    ToolTip="Caancel the import process" 
                    Click="btnCancel_Click" 
                    Content="Cancel" 
                    Width="150" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

            </StackPanel>
        </Grid>
    </Grid>
</Window>
