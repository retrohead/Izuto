<Window x:Class="Izuto.PACWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        Title="Izuto PAC Browser" Height="570" Width="800" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="txtPACFilePath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                <i:Interaction.Behaviors>
                    <local:TextBoxEnterKeyUpdateBehavior />
                </i:Interaction.Behaviors>
            </TextBox>


            <TabControl x:Name="tabsMain" Grid.Row="1" Margin="0,10,0,10" Style="{DynamicResource TabControlStyle1}" FontFamily="{DynamicResource IzutoFont}" FontSize="12" VerticalAlignment="Stretch">
                <TabItem x:Name="tabPageLinkedTextScripts" Header="Linked Scripts" Style="{DynamicResource TabItemStyle1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="listViewLinkedScripts" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="0" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}">
                            <ListView.View>

                                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Script ID" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Script Line #" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Text (Shift-JIS)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=2, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Extra Data (Hex)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=3, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SubItems, ConverterParameter=4, Converter={StaticResource ListConverter}}" Width="Auto" />
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,0">
                            <Button 
                    x:Name="btnModifyLinkedScript" 
                    ToolTip="Open the PAC file linked to the selected script" 
                    Click="btnModifyLinkedScript_Click" 
                    Content="Modify Linked Script" 
                    Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="2,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                        </StackPanel>
                    </Grid>

                </TabItem>

                <TabItem x:Name="tabPageTextScripts" Header="Text Scripts" Style="{DynamicResource TabItemStyle1}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*"/>
                            <ColumnDefinition Width="81*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                            <RowDefinition Height="32" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="listViewTextScripts" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="0" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}" Grid.ColumnSpan="2">
                            <ListView.View>

                                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Script ID" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Script Line #" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Text (Shift-JIS)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=2, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Text (Unicode Conversion)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=3, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SubItems, ConverterParameter=4, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding SubItems, ConverterParameter=5, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Unknown Data" DisplayMemberBinding="{Binding SubItems, ConverterParameter=6, Converter={StaticResource ListConverter}}" Width="Auto" />
                                </GridView>
                            </ListView.View>
                        </ListView>


                        <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="2">
                            <Button 
    x:Name="btnModifyString" 
    ToolTip="Modify the selected text string" 
    Click="btnModifyString_Click" 
    Content="Modify Selected String" 
    Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="2,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                            <Button 
x:Name="btnImport" 
ToolTip="Import strings from another region PKB file" 
Click="btnImport_Click" 
Content="Import Strings" 
Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                        </StackPanel>
                    </Grid>

                </TabItem>

                <TabItem x:Name="tabPageObjects" Header="Objects" Style="{DynamicResource TabItemStyle1}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="100*" />
                        </Grid.RowDefinitions>

                        <ListView x:Name="listViewObjects" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="0" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}" Grid.ColumnSpan="2">
                            <ListView.View>

                                <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                                    <GridViewColumn Header="Object" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Size (Bytes)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                                    <GridViewColumn Header="Hex" DisplayMemberBinding="{Binding SubItems, ConverterParameter=2, Converter={StaticResource ListConverter}}" Width="Auto" />
                                </GridView>
                            </ListView.View>
                        </ListView>


                    </Grid>

                </TabItem>

            </TabControl>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">

                    <Button 
                                x:Name="btnAccept" 
                                ToolTip="Import the changes made to PAC files into the loaded PKB file" 
                                Click="btnAccept_Click" 
                                Content="Import Changes to PKB" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />
                    <Button 
                                x:Name="btnExportPAC" 
                                ToolTip="Export and save the modifed PAC file" 
                                Click="btnExportPAC_Click" 
                                Content="Export Modified PAC" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
