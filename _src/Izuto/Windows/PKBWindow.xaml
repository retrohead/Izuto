<dckm:CustomWindowContentBase x:Class="Izuto.PKBWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:dckm="clr-namespace:Izuto.DockManager"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        MinHeight="519" MinWidth="800" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="textPKBPath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Grid.ColumnSpan="2" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                <i:Interaction.Behaviors>
                    <local:TextBoxEnterKeyUpdateBehavior />
                </i:Interaction.Behaviors>
            </TextBox>

            <ListView VerticalAlignment="Stretch" x:Name="listView1" SelectionChanged="listView1_SelectionChanged" ItemsSource="{Binding Items}" SelectedItem="{Binding Path=SelectedListItem}" SelectionMode="Single" Width="Auto" Height="Auto" Margin="5,10,5,5" Grid.Row="1" Grid.Column="0" Style="{DynamicResource ListViewStyle1}" ItemContainerStyle="{DynamicResource ListViewItemStyle1}"  FontSize="12" FontFamily="{DynamicResource IzutoFont}">
                <ListView.View>

                    <GridView ColumnHeaderContainerStyle="{DynamicResource GridViewColumnHeaderStyle}">
                        <GridViewColumn x:Name="listPKBFileIcons" Width="25">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image HorizontalAlignment="Right" Height="14" Source="{Binding icon}" VerticalAlignment="Center" Margin="0,3,0,3" Grid.Column="0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File" DisplayMemberBinding="{Binding SubItems, ConverterParameter=0, Converter={StaticResource ListConverter}}" Width="Auto" />
                        <GridViewColumn Header="Offset" DisplayMemberBinding="{Binding SubItems, ConverterParameter=1, Converter={StaticResource ListConverter}}" Width="Auto" />
                        <GridViewColumn Header="Offset (Hex)" DisplayMemberBinding="{Binding SubItems, ConverterParameter=2, Converter={StaticResource ListConverter}}" Width="Auto" />
                        <GridViewColumn Header="Size" DisplayMemberBinding="{Binding SubItems, ConverterParameter=3, Converter={StaticResource ListConverter}}" Width="Auto" />
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding SubItems, ConverterParameter=4, Converter={StaticResource ListConverter}}" Width="Auto" />
                        <GridViewColumn Header="Sub ID" DisplayMemberBinding="{Binding SubItems, ConverterParameter=5, Converter={StaticResource ListConverter}}" Width="Auto" />
                    </GridView>
                </ListView.View>
            </ListView>


            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100*"/>
                    <ColumnDefinition Width="200"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">

                    <Button 
                                x:Name="btnImportPKB" 
                                ToolTip="Import the changes made to PKB files into the loaded archive file" 
                                Click="btnImportPKB_Click" 
                                Content="Import Changes to FA" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                    <Button 
                                x:Name="btnExplorePAC" 
                                ToolTip="View the contents of the selected PAC File" 
                                Click="btnExplorePAC_Click" 
                                Content="Explore Selected PAC File" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />
                    <Button 
                                x:Name="btnExportPKB" 
                                ToolTip="Export and save the modifed PKB file" 
                                Click="btnExportPKB_Click" 
                                Content="Export Modified PKB" 
                                Width="150" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="5,-1,0,0" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" />

                </StackPanel>
                <TextBox x:Name="textSearch" GotFocus="textSearch_GotFocus" LostFocus="textSearch_LostFocus" KeyUp="textSearch_KeyUp" Text="Search By ID...." Foreground="{DynamicResource ControlBorder}" Grid.Column="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Margin="0,0,0,0" IsReadOnly="False" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
            </Grid>
        </Grid>
    </Grid>
</dckm:CustomWindowContentBase>
