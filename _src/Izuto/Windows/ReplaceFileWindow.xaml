<dckm:CustomWindowContentBase x:Class="Izuto.ReplaceFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:local="clr-namespace:Izuto"
xmlns:ui="clr-namespace:Izuto.UI"
xmlns:dckm="clr-namespace:Izuto.DockManager"
xmlns:controls="clr-namespace:Izuto.Controls"
xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
xmlns:system="clr-namespace:System;assembly=mscorlib"
mc:Ignorable="d"
Background="{DynamicResource WindowBackgroundBrushDark}"
Height="170" Width="700" MinHeight="240" MinWidth="700" MaxHeight="170" MaxWidth="700" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="0" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="32"/>
                <RowDefinition Height="42"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="1" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Path to replace:" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBox x:Name="textOriginalFilePath" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
                <Button Content="..." Grid.Column="2" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnBrowsePKB" Margin="1,0,0,0" ToolTip="Browse the loaded PKB for a file to replace" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnBrowsePKB_Click" />

            </Grid>


            <Grid Grid.Row="2" Margin="10,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Replacement file:" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                <TextBox x:Name="textReplacementFile" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                    <i:Interaction.Behaviors>
                        <local:TextBoxEnterKeyUpdateBehavior />
                    </i:Interaction.Behaviors>
                </TextBox>
                <Button Content="..." Grid.Column="2" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnBrowseLocal" Margin="1,0,0,0" ToolTip="Browse for a local file to insert" Height="25" HorizontalAlignment="Stretch" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnBrowseLocal_Click" />
            </Grid>

            <Button Grid.Row="3" Content="Confirm" x:Name="btnConfirm" Margin="1,5,0,-70" ToolTip="Confirm selections" Style="{DynamicResource PopUpAcceptButtonStyle}" Click="btnConfirm_Click" />

        </Grid>

    </Grid>
</dckm:CustomWindowContentBase>
