<dckm:CustomWindowContentBase x:Class="Izuto.StringWindow"
        
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:dckm="clr-namespace:Izuto.DockManager"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        Height="252" Width="513" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="txtString" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalAlignment="Stretch"  VerticalContentAlignment="Top" Grid.Column="0" Grid.Row="0" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}" Margin="0,5,0,5" />
            
            <Button 
            x:Name="btnApply" 
            ToolTip="Apply the changes made to string" 
            Click="btnApply_Click" 
            Content="Apply" 
            Grid.Row="1" Margin="5,-1,-10,-29"  HorizontalAlignment="Right" Style="{DynamicResource PopUpAcceptButtonStyle}" />

        </Grid>
    </Grid>
</dckm:CustomWindowContentBase>
