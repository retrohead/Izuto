<Window x:Class="Izuto.TextTranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Izuto"
        xmlns:ui="clr-namespace:Izuto.UI"
        xmlns:controls="clr-namespace:Izuto.Controls"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Background="{DynamicResource WindowBackgroundBrushDark}"
        Title="Izuto Text Translation Configuration" ResizeMode="NoResize" Height="250" Width="700" MinHeight="250" MinWidth="700" MaxHeight="250" MaxWidth="700" Loaded="Window_Loaded">
    <Grid Background="{DynamicResource WindowBackgroundBrushDark}">
        <Grid Margin="10,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="100*"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TabControl x:Name="tabsMain" Grid.Row="0" Margin="0,0,0,0" Style="{DynamicResource TabControlStyle1}" FontFamily="{DynamicResource IzutoFont}" FontSize="12" VerticalAlignment="Stretch">
                <TabItem x:Name="tabTextEntry" Header="Text Entry" Style="{DynamicResource TabItemStyle1}">
                    <Grid Margin="5,15,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="100*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Syllable (Unicode)" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textUnicodeEntry" TextChanged="textUnicodeEntry_TextChanged" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="False" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="Original Hex" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textOrigHex_Text" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="3" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>


                        <TextBlock Text="Replacement (Shift-JIS)" Grid.Row="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textJp_Text" Grid.Row="2" TextChanged="textJp_Text_TextChanged" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="False" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="Replacement Hex" Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textReplacementHex_Text" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="3" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="tabHexEntry" Header="Hex Entry" Style="{DynamicResource TabItemStyle1}">
                    <Grid Margin="5,15,5,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="32"/>
                            <RowDefinition Height="100*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="50*"/>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="50*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Original Hex" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textOrigHex" TextChanged="textOrigHex_TextChanged" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="False" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="Syllable (Unicode)" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textSyllable" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="3" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>


                        <TextBlock Text="Replacement Hex" Grid.Row="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textReplacementHex" TextChanged="textReplacementHex_TextChanged" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="1" Margin="0,0,0,0" IsReadOnly="False" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                        <TextBlock Text="Replacement (Shift-JIS)" Grid.Row="2" Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center" Width="170" FontFamily="{DynamicResource VestasSans}" Foreground="{DynamicResource LabelTextBrush}" />
                        <TextBox x:Name="textJp" Grid.Row="2" Background="{DynamicResource WindowBackgroundBrushMedium}" Grid.Column="3" Margin="0,0,0,0" IsReadOnly="True" Height="27" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" VerticalAlignment="Center" FontFamily="{DynamicResource VestasSans}" FontSize="12" Padding="2,2,2,2" Style="{DynamicResource TextBoxStyle1}"  >
                            <i:Interaction.Behaviors>
                                <local:TextBoxEnterKeyUpdateBehavior />
                            </i:Interaction.Behaviors>
                        </TextBox>
                    </Grid>
                </TabItem>
            </TabControl>

            <Button Content="Apply Changes" Width="150" Grid.Row="1" Background="{DynamicResource WindowBackgroundBrushMedium}" x:Name="btnConfirm" Margin="1,5,0,0" ToolTip="Confirm selections" Height="30" HorizontalAlignment="Left" Cursor="Hand" Style="{DynamicResource ButtonStyleImage}" Click="btnConfirm_Click" />

        </Grid>
    </Grid>
</Window>
